From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ilia Alshanetsky <ilia@ilia.ws>
Date: Sun, 18 Oct 2026 00:00:00 -0400
Subject: [PATCH 17/26] Bound the parsed type AST cache

ParseTypeName() keeps every distinct type name it parses in a
process-wide map with no eviction, so a server that sends many
distinct type names, one zero-row block each, grows client memory
without bound.

The cache now holds at most kTypeAstCacheMaxEntries entries and
kTypeAstCacheMaxBytes of type-name text. An insert that would exceed
either limit clears the cache first, and a name longer than the byte
budget is parsed on every call without being cached. The cleared map
is destroyed after the mutex is released.

Clearing would invalidate ASTs that callers are still using, so
ParseTypeName() now returns std::shared_ptr<const TypeAst> instead of
a pointer into the map. This changes a function declared in an
installed header; the in-tree caller compiles unchanged.
---
 clickhouse/types/type_parser.h   | 9 +++++++--
 clickhouse/types/type_parser.cpp | 29 ++++++++++++++++++-----------
 2 files changed, 25 insertions(+), 13 deletions(-)

diff --git a/clickhouse/types/type_parser.h b/clickhouse/types/type_parser.h
--- a/clickhouse/types/type_parser.h
+++ b/clickhouse/types/type_parser.h
@@ -92,7 +92,12 @@
     std::string scratch_;
 };
 
+/// ParseTypeName() keeps parsed ASTs in a process-wide cache. When adding an
+/// entry would exceed either limit, the cache is cleared first. A type name
+/// longer than kTypeAstCacheMaxBytes is parsed on every call and never cached.
+inline constexpr size_t kTypeAstCacheMaxEntries = 4096;
+inline constexpr size_t kTypeAstCacheMaxBytes   = 256 * 1024;
 
-const TypeAst* ParseTypeName(const std::string& type_name);
-
+/// Returns nullptr if type_name is not a valid type.
+std::shared_ptr<const TypeAst> ParseTypeName(const std::string& type_name);
 }
diff --git a/clickhouse/types/type_parser.cpp b/clickhouse/types/type_parser.cpp
--- a/clickhouse/types/type_parser.cpp
+++ b/clickhouse/types/type_parser.cpp
@@ -336,25 +336,32 @@
     return Token{Token::EOS, StringView()};
 }
 
-
-const TypeAst* ParseTypeName(const std::string& type_name) {
-    // Cache for type_name.
-    // Usually we won't have too many type names in the cache, so do not try to
-    // limit cache size.
-    static std::map<std::string, TypeAst> ast_cache;
+std::shared_ptr<const TypeAst> ParseTypeName(const std::string& type_name) {
+    static std::map<std::string, std::shared_ptr<const TypeAst>> ast_cache;
+    static size_t ast_cache_bytes = 0;
     static std::mutex lock;
 
+    // Declared before the guard so a cleared cache is destroyed after the mutex is released.
+    std::map<std::string, std::shared_ptr<const TypeAst>> evicted;
     std::lock_guard<std::mutex> guard(lock);
     auto it = ast_cache.find(type_name);
     if (it != ast_cache.end()) {
-        return &it->second;
+        return it->second;
     }
 
-    TypeAst ast;
-    if (!TypeParser(type_name).Parse(&ast)) {
+    auto ast = std::make_shared<TypeAst>();
+    if (!TypeParser(type_name).Parse(ast.get())) {
         return nullptr;
     }
-    return &ast_cache.emplace(type_name, std::move(ast)).first->second;
-}
 
+    if (type_name.size() <= kTypeAstCacheMaxBytes) {
+        if (ast_cache.size() >= kTypeAstCacheMaxEntries || ast_cache_bytes + type_name.size() > kTypeAstCacheMaxBytes) {
+            evicted.swap(ast_cache);
+            ast_cache_bytes = 0;
+        }
+        ast_cache.emplace(type_name, ast);
+        ast_cache_bytes += type_name.size();
+    }
+    return ast;
+}
 }
