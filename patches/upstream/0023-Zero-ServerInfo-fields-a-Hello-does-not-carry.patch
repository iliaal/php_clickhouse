From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Ilia Alshanetsky <ilia@ilia.ws>
Date: Sun, 18 Oct 2026 10:21:39 -0400
Subject: [PATCH 23/30] Zero ServerInfo fields a Hello does not carry

Default-initialize the numeric ServerInfo members and reset server_info_
before parsing each Hello, so fields an old-revision server omits read as
zero instead of indeterminate or previous-server values.
---
 clickhouse/client.cpp | 2 ++
 clickhouse/client.h   | 8 ++++----
 2 files changed, 6 insertions(+), 4 deletions(-)

diff --git a/clickhouse/client.cpp b/clickhouse/client.cpp
--- a/clickhouse/client.cpp
+++ b/clickhouse/client.cpp
@@ -1222,6 +1222,8 @@
     }
 
     if (packet_type == ServerCodes::Hello) {
+        server_info_ = ServerInfo{};
+
         if (!WireFormat::ReadString(*input_, &server_info_.name)) {
             return false;
         }
diff --git a/clickhouse/client.h b/clickhouse/client.h
--- a/clickhouse/client.h
+++ b/clickhouse/client.h
@@ -37,10 +37,10 @@
     std::string name;
     std::string timezone;
     std::string display_name;
-    uint64_t    version_major;
-    uint64_t    version_minor;
-    uint64_t    version_patch;
-    uint64_t    revision;
+    uint64_t    version_major = 0;
+    uint64_t    version_minor = 0;
+    uint64_t    version_patch = 0;
+    uint64_t    revision = 0;
 };
 
 /// Methods of block compression.
