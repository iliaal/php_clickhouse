From 44f54c5bdbed777f8b1d0d30599d5fa15e616207 Mon Sep 17 00:00:00 2001
From: Andrew Slabko <andrew@slabko.com>
Date: Thu, 6 Aug 2026 18:52:30 +0200
Subject: [PATCH] Clear Tuple elements in place

Backport of the ColumnTuple::Clear hunk of upstream 44f54c5 ("Make
composite Swap and Tuple Clear alias-coherent"). columns_.clear() dropped
the element columns, so a cleared Tuple became Tuple() and a cleared Map
lost its key/value columns. Clear each element in place instead.
---
 clickhouse/columns/tuple.cpp | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/clickhouse/columns/tuple.cpp b/clickhouse/columns/tuple.cpp
index 75f01ce..aca294d 100644
--- a/clickhouse/columns/tuple.cpp
+++ b/clickhouse/columns/tuple.cpp
@@ -142,7 +142,11 @@ void ColumnTuple::SaveBody(OutputStream* output) {
 }
 
 void ColumnTuple::Clear() {
-    columns_.clear();
+    // Clear each element column in place (do NOT drop the element handles): this preserves the
+    // tuple structure and the element objects' identity, so any As<>/Wrap views stay coherent.
+    for (auto & column : columns_) {
+        column->Clear();
+    }
 }
 
 void ColumnTuple::Swap(Column& other) {
-- 
