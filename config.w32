// vim:ft=javascript

ARG_ENABLE("clickhouse", "Enable ClickHouse client support", "no");
ARG_ENABLE("clickhouse-openssl", "Enable TLS/SSL support in php_clickhouse (requires OpenSSL)", "no");

if (PHP_CLICKHOUSE != "no") {
    var ext_dir = configure_module_dirname;
    var codec_root = ext_dir + "\\lib\\compression";

    ADD_FLAG("CFLAGS_CLICKHOUSE", "/std:c11 /DNOMINMAX /DZSTD_DISABLE_ASM /D_CRT_SECURE_NO_WARNINGS /D_WINSOCK_DEPRECATED_NO_WARNINGS");
    ADD_FLAG("LDFLAGS_CLICKHOUSE", "ws2_32.lib");

    ADD_FLAG("CFLAGS_CLICKHOUSE",
        "/I" + ext_dir + "\\lib\\clickhouse-c" +
        " /I" + codec_root + "\\lz4" +
        " /I" + codec_root + "\\zstd" +
        " /I" + codec_root + "\\zstd\\common");

    if (PHP_CLICKHOUSE_OPENSSL != "no") {
        if (CHECK_LIB("libssl.lib", "clickhouse") &&
            CHECK_LIB("libcrypto.lib", "clickhouse") &&
            CHECK_HEADER_ADD_INCLUDE("openssl/ssl.h", "CFLAGS_CLICKHOUSE")) {
            ADD_FLAG("CFLAGS_CLICKHOUSE", "/DWITH_OPENSSL");
            AC_DEFINE("WITH_OPENSSL", 1, "Build php_clickhouse with TLS/SSL support");
        } else {
            ERROR("--enable-clickhouse-openssl was requested but libssl/libcrypto/openssl headers were not found. Install OpenSSL or drop the flag.");
        }
    }

    EXTENSION("clickhouse", "clickhouse.c ch_backend.c ch_protocol.c ch_query.c ch_insert.c ch_results.c ch_types_read.c ch_types_write.c ch_wide.c metadata.c query_log.c", null, "/DZEND_ENABLE_STATIC_TSRMLS_CACHE=1");
    ADD_EXTENSION_DEP("clickhouse", "json");

    ADD_SOURCES(codec_root + "\\lz4", "lz4.c lz4hc.c", "clickhouse");
    ADD_SOURCES(codec_root + "\\zstd\\common",
        "debug.c entropy_common.c error_private.c fse_decompress.c pool.c threading.c xxhash.c zstd_common.c", "clickhouse");
    ADD_SOURCES(codec_root + "\\zstd\\compress",
        "fse_compress.c hist.c huf_compress.c zstd_compress.c zstd_compress_literals.c zstd_compress_sequences.c zstd_compress_superblock.c zstd_double_fast.c zstd_fast.c zstd_lazy.c zstd_ldm.c zstd_opt.c zstdmt_compress.c", "clickhouse");
    ADD_SOURCES(codec_root + "\\zstd\\decompress",
        "huf_decompress.c zstd_ddict.c zstd_decompress.c zstd_decompress_block.c", "clickhouse");
}
