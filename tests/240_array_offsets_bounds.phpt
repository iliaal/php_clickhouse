6f6c536c6f747341637175697265644e6f6e436f
HEX
);
$r = wire_run(wire_default_hello_hex(), $w9, wire_select_op(ClickHouse::DATE_AS_STRINGS));
echo "w9: ", $r[0] === "exception" ? "rejected" : json_encode($r), "\n";

function offsets(array $values) {
    $out = "";
    foreach ($values as $v) $out .= wire_u64($v);
    return $out;
}

$cases = [
    /* Offsets [3, 1] over one UInt8: row 1 would silently read as []. */
    "uint8-backwards" => [["c0", "Array(UInt8)", offsets([3, 1]) . "\x07"]],
    /* Offsets [0x50000001, 1]: a Nothing slice trusts the bogus length. */
    "nothing-huge" => [["c0", "Array(Nothing)", offsets([0x50000001, 1]) . "\x00"]],
    "map-nothing-huge" => [["c0", "Map(Nothing, Nothing)", offsets([0x50000001, 1]) . "\x00\x00"]],
    "valid-uint8" => [["c0", "Array(UInt8)", offsets([2, 3]) . "\x01\x02\x03"]],
    "valid-nothing" => [["c0", "Array(Nothing)", offsets([0, 0])]],
    "valid-map-nothing" => [["c0", "Map(Nothing, Nothing)", offsets([0, 0])]],
    "valid-map" => [["c0", "Map(String, UInt8)", offsets([1, 1]) . "\x01a" . "\x05"]],
];
foreach ($cases as $name => $columns) {
    /* Map(Nothing, ...) has no supported key type outside MAP_AS_PAIRS. */
    $modes = $name === "valid-map-nothing" ? [ClickHouse::MAP_AS_PAIRS] : [0, ClickHouse::MAP_AS_PAIRS];
    foreach ($modes as $flags) {
        $r = wire_run(wire_default_hello_hex(), bin2hex(wire_select_response($columns, 2)),
                      wire_select_op($flags));
        echo "$name/$flags: ", $r[0] === "exception" ? "rejected" : $r[0] . " " . json_encode($r[1]), "\n";
    }
}
?>
--EXPECT--
