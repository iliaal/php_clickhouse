uint8-backwards/0: rejected
uint8-backwards/256: rejected
nothing-huge/0: rejected
nothing-huge/256: rejected
map-nothing-huge/0: rejected
map-nothing-huge/256: rejected
valid-uint8/0: ok [{"c0":[1,2]},{"c0":[3]}]
valid-uint8/256: ok [{"c0":[1,2]},{"c0":[3]}]
valid-nothing/0: ok [{"c0":[]},{"c0":[]}]
valid-nothing/256: ok [{"c0":[]},{"c0":[]}]
valid-map-nothing/256: ok [{"c0":[]},{"c0":[]}]
valid-map/0: ok [{"c0":{"a":5}},{"c0":[]}]
valid-map/256: ok [{"c0":[["a",5]]},{"c0":[]}]
