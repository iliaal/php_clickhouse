--TEST--
Array and Map reads reject offsets that point outside the nested column
--EXTENSIONS--
clickhouse
--SKIPIF--
<?php
if (!function_exists("proc_open")) print "skip proc_open unavailable";
?>
--FILE--
<?php
require __DIR__ . "/_wire_mock.inc";

/* Mutated Array(Nothing) / Nullable(Nothing) block whose non-monotonic offsets
 * yield a slice of 1309765121 elements. */
$w9 = preg_replace('/\s+/', '', <<<'HEX'
